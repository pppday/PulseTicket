# PulseTicket Microservices Environment Template (Copy to .env for local dev)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

NACOS_SERVER_ADDR=127.0.0.1:8848
SEATA_SERVER_ADDR=127.0.0.1:8091

JWT_SECRET=PulseTicketMicroserviceGatewayJwtSecretKey2026EnterpriseEdition8899

# Python Agent LLM & Hybrid RAG (Embedding / Rerank / PostgreSQL pgvector)
LLM_API_KEY=
# 未配 EMBEDDING_API_KEY 时自动降级为 BM25-only 关键词检索（不使用假向量）
# 推荐硅基流动 https://cloud.siliconflow.cn 免费额度（BAAI/bge-m3 + BAAI/bge-reranker-v2-m3）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# PostgreSQL + pgvector 向量库连接串（留空则在有 Embedding Key 时退回内存向量矩阵）
PGVECTOR_DSN=postgresql://pulseticket:pulseticket@127.0.0.1:5432/pulseticket_rag
PGVECTOR_TABLE=ticket_kb_chunks
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=50
